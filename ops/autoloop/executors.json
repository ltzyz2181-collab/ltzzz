{
  "schema": "ltzzz.autoloop.executors.v1",
  "note": "只有登记在这里、且命令首项在白名单内的执行器才会被自动运行。Issue 正文永不执行。verify 通过且无任何失败检查时，auto_merge 才会合并。",
  "executors": [
    {
      "id": "task-hub-status",
      "match": {
        "label": "autoloop:exec:task-hub-status"
      },
      "command": [
        "node",
        "scripts/task-hub.mjs",
        "status",
        "--out",
        "knowledge/results/task-hub/latest.json"
      ],
      "auto_merge": false,
      "risk": "low",
      "produces": [
        "knowledge/results/task-hub/latest.json"
      ],
      "verify": [
        "node",
        "--check",
        "scripts/task-hub.mjs"
      ]
    },
    {
      "id": "oversight-merge",
      "match": {
        "label": "autoloop:exec:oversight-merge"
      },
      "command": [
        "node",
        "scripts/merge-oversight-backlog.mjs",
        "--json",
        "knowledge/results/dispatch/oversight/merged-latest.json",
        "--md",
        "ops/task-continuity/oversight-merged-latest.md"
      ],
      "auto_merge": true,
      "risk": "low",
      "produces": [
        "knowledge/results/dispatch/oversight/merged-latest.json",
        "ops/task-continuity/oversight-merged-latest.md"
      ],
      "verify": [
        "node",
        "--test",
        "scripts/tests/merge-oversight-backlog.test.mjs"
      ]
    },
    {
      "id": "relay-patch",
      "match": {
        "label": "autoloop:exec:relay-patch"
      },
      "command": [
        "node",
        "scripts/relay-patch.mjs",
        "--apply"
      ],
      "verify": [
        "node",
        "scripts/relay-patch.mjs",
        "--verify-only"
      ],
      "auto_merge": true,
      "risk": "medium",
      "produces": [
        "paths declared in the card body"
      ],
      "note": "relay-claude 只能改卡上 paths: 声明的文件；钱包/密钥/凭据路径一律拒绝"
    }
  ]
}
