  "token_injection": {
    "github_actions_seats": {
      "channel": "GITHUB_TOKEN",
      "value_in_repo": false,
      "note": "Actions 自动注入；不需要 PAT"
    },
    "local_cli_seats": {
      "channel": "GH_TOKEN / GITHUB_TOKEN",
      "value_in_repo": false,
      "note": "scripts/seat-token-env.sh|ps1 --exec，从 git credential fill 或现有 env 读取，不打印"
    },
    "workbuddy_web": {
      "channel": "none",
      "value_in_repo": false,
      "note": "Web 应用无法注入 env；只能走 mail:send Issue / 仓库任务，不要把 PAT 粘进对话"
    },
    "meta_hosted": {
      "channel": "META_WORKER_TOKEN",
      "value_in_repo": false,
      "note": "Worker secret；不向模型提供 GitHub PAT"
    },
    "meta_issues": {
      "channel": "GITHUB_ISSUES_TOKEN",
      "value_in_repo": false,
      "note": "仅 Issues: Read and write 的 fine-grained PAT；由 repo secret META_ISSUES_PAT 装入 worker secret；只能开 Issue，不能推代码"
    },
    "external_models": {
      "channel": "none",
      "value_in_repo": false,
      "note": "外部模型席位不得持有 PAT；需要写库时用代理或 fine-grained PAT + 最小权限"
    }
  },
  "limits": {
    "max_recipients_per_mail": 8,
    "no_credentials_in_body": true,
    "no_customer_body_in_receipt": true,
    "no_pat_in_prompt": true
  }
}
