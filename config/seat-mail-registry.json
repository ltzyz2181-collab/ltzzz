{
  "schema": "ltzzz.seat-mail-registry.v1",
  "effective_date": "2026-11-20",
  "source": "owner instruction 2026-11-20 + config/deep-superagent.json + config/mail-allowlist-20261119.json",
  "repo_visibility": "public",
  "principle": "仓库只存地址、传输方式和凭据名称，不存密码/授权码/PAT。席位通过 seat-mail relay 发信，不需要各自持有 SMTP 凭据。",
  "shared_mailbox": {
    "address": "306122054@qq.com",
    "routing": "[seat:<seat>]",
    "note": "owner QQ 邮箱；桌面 GPT / 桌面 Claude 的项目通信地址。Deep/千问没有核实到独立 QQ 邮箱，不得把该地址记作它们自己的邮箱。"
  },
  "owner": {
    "address": "ltzyz2181@gmail.com",
    "kind": "owner"
  },
  "credential_refs": {
    "smtp_shared_qq": {
      "env": [
        "MAIL_SMTP_HOST",
        "MAIL_SMTP_USER",
        "MAIL_SMTP_PASSWORD"
      ],
      "where": "GitHub Actions Secrets（仓库）或 ~/.config/ltzzz/qq-mail.env（桌面，chmod 600）",
      "value_in_repo": false
    },
    "gmail_imap": {
      "env": [
        "GMAIL_IMAP_USER",
        "GMAIL_IMAP_APP_PASSWORD"
      ],
      "where": "GitHub Actions Secrets",
      "value_in_repo": false
    },
    "agent_mail_agently": {
      "env": [
        "AGENTLY_CLI_SESSION"
      ],
      "where": "本机 agently-cli 登录态，不入库",
      "value_in_repo": false
    },
    "meta_hosted": {
      "env": [
        "META_WORKER_URL",
        "META_WORKER_TOKEN",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ],
      "where": "GitHub Actions Secrets + Cloudflare Worker secret；token 可由 CF token HMAC 派生",
      "value_in_repo": false
    },
    "github_actions": {
      "env": [
        "GITHUB_TOKEN"
      ],
      "where": "GitHub Actions 自动注入；权限由 workflow permissions 决定",
      "value_in_repo": false
    },
    "github_local": {
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN"
      ],
      "where": "仅本地进程 env；用 scripts/seat-token-env.sh|ps1 --exec 注入，不落盘",
      "value_in_repo": false
    }
  },
  "transports": {
    "seat_mail_relay": {
      "how": "开一张 label=mail:send 的 Issue，写 seat/to/subject/正文；.github/workflows/seat-mail.yml 每 30 分钟发信并回执",
      "credentials_needed_by_seat": false
    },
    "agently_cli": {
      "how": "腾讯 Agent Mail agently-cli，本机登录态读取/发送",
      "credentials_needed_by_seat": true
    },
    "smtp_shared_qq": {
      "how": "smtp.qq.com:465 SSL；凭据只在 Actions Secrets 或桌面 600 env 文件",
      "credentials_needed_by_seat": false
    }
  },
  "relay_permissions": {
    "source": "owner 2026-11-23: 同意开 mail:send relay 限权给 Meta，不给 PAT",
    "principle": "席位只拿到「排队一张 mail:send 卡」的权限；SMTP 凭据和 GitHub PAT 都不下放，发送由定时 relay 完成。",
    "default": {
      "enabled": true,
      "note": "既有席位维持原行为；本段只给 Meta 增加明确上限。"
    },
    "seats": {
      "meta": {
        "enabled": true,
        "granted_by": "owner",
        "granted_at": "2026-11-23",
        "scope": "outbound mail only via label=mail:send; no PAT, no SMTP credential, no attachments",
        "entry": "Meta worker POST /mail（Bearer META_WORKER_TOKEN）创建受限卡片",
        "recipients": [
          "owner",
          "doubao",
          "workbuddy",
          "deep",
          "desktop_gpt",
          "desktop_claude",
          "desktop_codex",
          "relay_gpt",
          "relay_claude",
          "kimi_cn",
          "xai"
        ],
        "daily_cap": 10,
        "max_body_bytes": 24576,
        "max_body_bytes_note": "策略上限 6000 字符；按 UTF-8 最坏 4 字节/字符约 24000 字节，留出卡片头余量",
        "self_recipient_allowed": false
      }
    }
  },
