      "post": {
        "summary": "/market/skill/{id}",
        "responses": {
          "200": {
            "description": "Public data or accepted operation"
          },
          "202": {
            "description": "Funded order pending delivery or pending membership review"
          },
          "402": {
            "description": "x402 v2 Payment Required; retry with PAYMENT-SIGNATURE"
          },
          "503": {
            "description": "Required treasury or facilitator unavailable"
          }
