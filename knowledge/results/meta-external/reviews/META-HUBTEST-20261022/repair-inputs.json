  "inputs": [
    {
      "path": "scripts/aave-owner-funding.mjs",
      "sha256": "1e3db23737d56dc6d4c64a39ff94ecd7919800f87d435da32ac36e7fc9e3380d",
      "bytes": 7551,
      "body": "import {fundingAmount} from './funding-plan.mjs';\nimport fs from 'node:fs';\nimport solc from 'solc';\nimport {Contract,ContractFactory,JsonRpcProvider,Wallet,id,parseUnits,Interface} from 'ethers';\nconst dir='knowledge/results/funding';fs.mkdirSync(dir,{recursive:true});\nconst stamp=process.env.GITHUB_RUN_ID||String(Date.now());\nconst evidence={owner:process.env.FUNDING_OWNER||null,treasury:process.env.FUNDING_TREASURY||null,phase:'compile',transactions:[],deployed:false};\nconst record=(r)=>{fs.writeFileSync(`${dir}/${stamp}.json`,JSON.stringify({at:new Date().toISOString(),chainId:8453,...evidence,...r},null,2)+'\\n');console.log(r.status);};\nconst source=fs.readFileSync('invest-channel/contracts/OwnerAaveFunding.sol','utf8');\nconst build=JSON.parse(solc.compile(JSON.stringify({language:'Solidity',sources:{'Funding.sol':{content:source}},settings:{evmVersion:'shanghai',optimizer:{enabled:true,runs:200},outputSelection:{'*':{'*':['abi','evm.bytecode.object']}}}})));\nif(build.errors?.some(e=>e.severity==='error'))throw Error('Solidity compile failed');\nconst artifact=build.contracts['Funding.sol'].OwnerAaveFunding;\nfs.writeFileSync(`${dir}/contract-artifact.json`,JSON.stringify(artifact,null,2));\nconst env=process.env;\nif(env.FUNDING_EXECUTE!=='1'){record({status:'compiled_read_only',signed:false,tx_hash:null});process.exit(0);}\nconst authorization=(router,executor)=>[\n {purpose:'Approve bounded aUSDC funding grant; revocable',chainId:8453,from:env.FUNDING_OWNER,to:'0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB',value:'0',data:new Interface(['function approve(address,uint256)']).encodeFunctionData('approve',[router,200000000n])},\n {purpose:'Activate funding with 200USDC total grant;100/200 hard caps (batch 2026-10 directive, not 1000)',chainId:8453,from:env.FUNDING_OWNER,to:router,value:'0',data:new Interface(['function configure(bool,address,uint256)']).encodeFunctionData('configure',[false,executor,200000000n])}\n];\nconst missing=['FUNDING_OWNER','FUNDING_TREASURY','FUNDING_EXECUTOR_KEY'].filter(k=>!env[k]);\nif(missing.length){record({status:'blocked_configuration',missing,compiled:true,deployed:false});process.exit(0);}\ntry{\n if(['0x1893a134aa6ea22e8c08518b559e1706f4da0ef7','0x21f502f29294c50d9c37a30dc038d8d95eb97fdc','0x872c322e886ccd3f2bb63e0611a6d8c620d859ab'].includes(env.FUNDING_TREASURY.toLowerCase())){record({status:'blocked_treasury_role',deployed:false,note:'Use a new Base operational treasury, not the U-card receiver or exposed legacy wallet.'});process.exit(0);}\n const prior=fs.readdirSync(dir).filter(f=>f.endsWith('.json')&&f!=='contract-artifact.json'&&f!==stamp+'.json').map(f=>JSON.parse(fs.readFileSync(`${dir}/${f}`)));\n if(prior.some(r=>r.status==='failed_chain_operation'&&r.deployed===null||r.transactions?.some(t=>['submitted','unknown'].includes(t.status)))){record({status:'blocked_prior_operation_requires_reconciliation',signed:false,tx_hash:null});process.exit(0);}\n evidence.phase='read_network';\n const provider=new JsonRpcProvider(env.LTZZZ_BASE_RPC||'https://mainnet.base.org');\n if((await provider.getNetwork()).chainId!==8453n)throw Error('Wrong network');\n const signer=new Wallet(env.FUNDING_EXECUTOR_KEY,provider);\n let address=env.FUNDING_ROUTER_ADDRESS;\n if(!address){\n  // Do not redeploy after a receipt has committed, even if variables are not yet updated.\n  const files=fs.readdirSync(dir).filter(f=>f.endsWith('.json')&&f!=='contract-artifact.json');\n  for(const file of files){const r=JSON.parse(fs.readFileSync(`${dir}/${file}`));if(r.status==='deployed_paused'&&r.owner.toLowerCase()===env.FUNDING_OWNER.toLowerCase()&&r.treasury.toLowerCase()===env.FUNDING_TREASURY.toLowerCase())address=r.router;}\n }\n if(!address){\n  evidence.phase='deploy';\n  const deployed=await new ContractFactory(artifact.abi,artifact.evm.bytecode.object,signer).deploy(env.FUNDING_OWNER,env.FUNDING_TREASURY,'0xA238Dd80C259a72e81d7e4664a9801593F98d1c5','0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913','0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB',signer.address);\n  const deploymentTx=deployed.deploymentTransaction();evidence.router=await deployed.getAddress();evidence.transactions.push({kind:'deploy',tx_hash:deploymentTx.hash,status:'submitted'});record({status:'deployment_submitted',tx_hash:deploymentTx.hash});\n  const receipt=await deploymentTx.wait();evidence.transactions.at(-1).status=receipt.status===1?'confirmed':'reverted';evidence.deployed=receipt.status===1;if(receipt.status!==1)throw Error('Deployment reverted');\n  record({status:'deployed_paused',owner:env.FUNDING_OWNER,treasury:env.FUNDING_TREASURY,router:await deployed.getAddress(),tx_hash:receipt.hash,block:receipt.blockNumber,deployed:true,owner_authorization:authorization(await deployed.getAddress(),signer.address),next:'Owner approve aUSDC and configure(false,executor,grant).'});process.exit(0);\n }\n evidence.router=address;evidence.deployed=true;evidence.phase='read_router';\n const router=new Contract(address,artifact.abi,signer);\n if((await router.owner()).toLowerCase()!==env.FUNDING_OWNER.toLowerCase()||(await router.treasury()).toLowerCase()!==env.FUNDING_TREASURY.toLowerCase()||(await router.executor()).toLowerCase()!==signer.address.toLowerCase())throw Error('Identity mismatch');\n if(await router.paused()){record({status:'blocked_owner_activation',router:address,deployed:true,owner_authorization:authorization(address,signer.address)});process.exit(0);}\n const token=new Contract(await router.usdc(),['function balanceOf(address) view returns(uint256)'],provider);\n const balance=await token.balanceOf(env.FUNDING_TREASURY);\n const target=parseUnits('100',6); // Refill only a verified shortage, never blindly withdraw daily.\n if(balance>=target){record({status:'no_refill_needed',router:address,treasury_usdc_raw:String(balance)});process.exit(0);}\n const day=BigInt(Math.floor(Date.now()/86400000));\n const dailyPulled=await router.dailyPulled(day);\n const plan=fundingAmount({balance,target,dailyPulled,grantRemaining:await router.grantRemaining(),lifetimePulled:await router.principalOutstanding()+await router.principalReturned()+await router.lossesAccepted()});\n if(plan.amount===0n){record({status:plan.status,router:address,deployed:true});process.exit(0);}\n const amount=plan.amount;\n const intent=id(`ltzzz-funding-v1:${address}:${day}:${await router.dailyPulled(day)}`);\n if(await router.usedIntent(intent)){record({status:'intent_already_executed',router:address,intent});process.exit(0);}\n await router.pull.staticCall(amount,intent);\n evidence.phase='pull';const tx=await router.pull(amount,intent);evidence.transactions.push({kind:'pull',tx_hash:tx.hash,status:'submitted'});record({status:'funding_submitted',tx_hash:tx.hash,intent});const receipt=await tx.wait();evidence.transactions.at(-1).status=receipt.status===1?'confirmed':'reverted';\n if(receipt.status!==1)throw Error('Funding reverted');\n const after=await token.balanceOf(env.FUNDING_TREASURY);\n record({status:'funded',router:address,amount_raw:String(amount),funding_stage:plan.stage,before_raw:String(balance),after_raw:String(after),tx_hash:receipt.hash,block:receipt.blockNumber,intent,principal_outstanding_raw:String(await router.principalOutstanding())});\n}catch{record({status:evidence.transactions.some(t=>t.status==='submitted')?'pending_reconciliation':'failed_before_confirmed_operation',tx_hash:evidence.transactions.at(-1)?.tx_hash||null,note:'Phase and transaction evidence retained; no raw provider error or credential printed. No automatic resend of uncertain transactions.'});process.exitCode=1;}\n"
    },
