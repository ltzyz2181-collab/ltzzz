{
  "artifact": {
    "tests": [
      {
        "id": "HEALTH_001",
        "label": "健康检查必须返回200且ok=true；失败表示服务不可用或基础健康契约不匹配。",
        "method": "GET",
        "path": "/health",
        "auth": "public",
        "body": null,
        "expected_http": 200,
        "expected_json": {
          "ok": true
        }
      },
      {
        "id": "TREASURY_001",
        "label": "国库市场信息必须返回受控国库地址；失败表示国库路由、链上配置或地址契约错误。",
        "method": "GET",
        "path": "/market/treasury",
        "auth": "public",
        "body": null,
        "expected_http": 200,
        "expected_json": {
          "ok": true,
          "controlled": true,
          "address": "0x5df5778E0A13df2aE983BDAD69cFCBD3DD7a32d"
        }
      },
      {
        "id": "AAVE_STATUS_001",
        "label": "Aave市场状态必须公开返回Base链ID 8453；失败表示市场状态接口或链配置不符合契约。",
        "method": "GET",
        "path": "/market/aave/status",
        "auth": "public",
        "body": null,
        "expected_http": 200,
        "expected_json": {
          "ok": true,
          "chain_id": 8453
        }
      },
      {
        "id": "RUNNER_READINESS_PUBLIC_001",
        "label": "运行器就绪状态在未认证时必须返回200和authenticated=false；若返回401则错误地把公开探针当作受保护接口。",
        "method": "GET",
        "path": "/market/runner/readiness",
        "auth": "public",
        "body": null,
        "expected_http": 200,
        "expected_json": {
          "authenticated": false
        }
      },
      {
        "id": "RUNNER_READINESS_VALID_001",
        "label": "运行器就绪状态在有效认证时必须返回authenticated=true，且不得返回status字符串；失败表示认证识别或响应结构偏离契约。",
        "method": "GET",
        "path": "/market/runner/readiness",
        "auth": "valid",
        "body": null,
        "expected_http": 200,
        "expected_json": {
          "authenticated": true
        }
      },
      {
        "id": "AAVE_PREVIEW_PUBLIC_001",
        "label": "公开调用Aave预览必须被PIN要求拦截；失败表示未认证请求可能绕过PIN保护。",
        "method": "POST",
        "path": "/market/aave/preview",
        "auth": "public",
        "body": {
          "intent_id": "CONTRACT_TEST_INTENT_20261013",
          "action": "supply",
          "amount_usdc": "1"
        },
        "expected_http": 401,
        "expected_json": {
          "error": "pin_required"
        }
      },
      {
        "id": "AAVE_PREVIEW_WRONG_001",
        "label": "错误认证调用Aave预览必须返回pin_required；失败表示无效凭证处理或PIN拦截不正确。",
        "method": "POST",
        "path": "/market/aave/preview",
        "auth": "wrong",
        "body": {
          "intent_id": "CONTRACT_TEST_INTENT_20261013",
          "action": "supply",
          "amount_usdc": "1"
        },
        "expected_http": 401,
        "expected_json": {
          "error": "pin_required"
        }
      },
      {
        "id": "AAVE_PREVIEW_VALID_ARBITRARY_TO_001",
        "label": "即使认证有效，预览请求也禁止携带任意to参数；失败表示任意交易参数可能被接受，存在越权目标风险。",
        "method": "POST",
        "path": "/market/aave/preview",
        "auth": "valid",
        "body": {
          "intent_id": "CONTRACT_TEST_INTENT_20261013",
          "action": "supply",
          "amount_usdc": "1",
          "to": "0x0000000000000000000000000000000000000000"
        },
        "expected_http": 422,
        "expected_json": {
          "error": "arbitrary_transaction_parameters_forbidden"
        }
      }
    ]
  },
