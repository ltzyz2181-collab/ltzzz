        "outputs": [
          {
            "seat": "qianwen",
            "actual_provider": "aliyun_dashscope",
            "task": "Implement append-only evidence record storage with duplicate URL/content detection, changed content handling, and missing timestamp rejection.",
            "text": "<<<FILE:src/evidenceStorage.js>>>\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\n\nclass EvidenceStorage {\n  constructor(filePath) {\n    this.filePath = filePath;\n    if (!fs.existsSync(this.filePath)) {\n      fs.writeFileSync(this.filePath, '[]', 'utf-8');\n    }\n  }\n\n  async storeEvidence(evidence) {\n    const existingEvidences = JSON.parse(fs.readFileSync(this.filePath, 'utf-8'));\n    const evidenceHash = crypto.createHash('sha256').update(JSON.stringify(evidence)).digest('hex');\n    \n    // Check for duplicate URL or content\n    if (existingEvidences.some(item => item.url === evidence.url || item.hash === evidenceHash)) {\n      throw new Error('Duplicate URL or content detected.');\n    }\n\n    // Check for missing timestamp\n    if (!evidence.timestamp) {\n      throw new Error('Timestamp is missing.');\n    }\n\n    // Append the new evidence\n    existingEvidences.push({ ...evidence, hash: evidenceHash });\n    fs.writeFileSync(this.filePath, JSON.stringify(existingEvidences, null, 2), 'utf-8');\n  }\n\n  getEvidences() {\n    return JSON.parse(fs.readFileSync(this.filePath, 'utf-8'));\n  }\n}\n\nmodule.exports = EvidenceStorage;\n<<<END>>>\n\n<<<FILE:test/evidenceStorage.test.js>>>\nconst { EvidenceStorage } = require('../src/evidenceStorage');\nconst fs = require('fs');\nconst path = require('path');\n\ndescribe('Evidence Storage', () => {\n  const testFilePath = path.join(__dirname, 'test-evidence.json');\n  let evidenceStorage;\n\n  beforeEach(() => {\n    evidenceStorage = new EvidenceStorage(testFilePath);\n    if (fs.existsSync(testFilePath)) {\n      fs.unlinkSync(testFilePath);\n    }\n  });\n\n  afterEach(() => {\n    if (fs.existsSync(testFilePath)) {\n      fs.unlinkSync(testFilePath);\n    }\n  });\n\n  it('should store evidence and handle duplicates', async () => {\n    await evidenceStorage.storeEvidence({\n      url: 'http://example.com',\n      timestamp: new Date().toISOString(),\n      content: 'Test content'\n    });\n\n    expect(() => {\n      evidenceStorage.storeEvidence({\n        url: 'http://example.com',\n        timestamp: new Date().toISOString(),\n        content: 'Test content'\n      });\n    }).toThrow('Duplicate URL or content detected.');\n  });\n\n  it('should reject evidence with missing timestamp', async () => {\n    expect(() => {\n      evidenceStorage.storeEvidence({\n        url: 'http://example.com',\n        content: 'Test content'\n      });\n    }).toThrow('Timestamp is missing.');\n  });\n\n  it('should append-only and not modify existing records', async () => {\n    await evidenceStorage.storeEvidence({\n      url: 'http://example.com/1',\n      timestamp: new Date().toISOString(),\n      content: 'Test content 1'\n    });\n\n    await evidenceStorage.storeEvidence({\n      url: 'http://example.com/2',\n      timestamp: new Date().toISOString(),\n      content: 'Test content 2'\n    });\n\n    const evidences = evidenceStorage.getEvidences();\n    expect(evidences.length).toBe(2);\n    expect(evidences[0].url).toBe('http://example.com/1');\n    expect(evidences[1].url).toBe('http://example.com/2');\n  });\n});\n<<<END>>>",
            "sha256": "73117b2dc34cb42573c0c8f07adc55e3337a2ae2f1c2423eb014275299f40994",
            "request_id": "1cc3af33-e11d-45fe-a4a2-0b90915ee68c"
          }
