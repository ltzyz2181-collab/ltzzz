{
  "@context": [
    "https://www.w3.org/ns/did/v1",
    "https://w3id.org/security/suites/jws-2020/v1"
  ],
  "id": "did:ltzzz:deepseek",
  "alsoKnownAs": [
    "erc8004:pending-mainnet-mapping"
  ],
  "controller": "did:ltzzz:owner",
  "verificationMethod": [],
  "authentication": [],
  "assertionMethod": [],
  "service": [
    {
      "id": "did:ltzzz:deepseek#agent-card",
      "type": "agent-card",
      "serviceEndpoint": "https://ltzzz.com/api/agents/deepseek/card.json",
      "note": "只读JSON名片，不是模型生成或已签名DID证明。"
    },
    {
      "id": "did:ltzzz:deepseek#health-0",
      "type": "HealthProbe",
      "serviceEndpoint": "https://ltzzz-deepseek-proxy.ltzyz2181.workers.dev/health",
      "note": "当前探测见identity/endpoint-status.json；health不证明模型额度或真实生成。"
    },
    {
      "id": "did:ltzzz:deepseek#health-1",
      "type": "HealthProbe",
      "serviceEndpoint": "https://api-deep.ltzzz.com/health",
      "note": "当前探测见identity/endpoint-status.json；health不证明模型额度或真实生成。"
    }
  ],
  "ltzzz:profile": {
    "role": "研究、工程、清洗与分析",
    "votingSeat": true,
    "walletTier": "资金登记与控制以wallet/addresses.md和现有执行器为准；岗位任命不是签名权",
    "channels": [
      "deepseek-proxy-worker",
      "knowledge/ai-chats/DeepSeek 6 篇（含修行对照）"
    ],
    "workStatus": "active",
    "walletRegistrySource": "wallet/addresses.md",
    "walletSigning": false,
    "endpointStatusRef": "identity/endpoint-status.json",
    "roleSource": "identity/seat-registry.json",
    "nativeInferenceMode": "native_DeepSeek_API",
    "authoritySource": "config/autonomy-authority.json"
  },
  "ltzzz:memoryGate": {
    "requiredReads": [
      "ltzzz-memory/README.md",
      "ltzzz-memory/重要事件.md",
      "ltzzz-memory/项目历史.md",
      "ltzzz-memory/装备论.md",
      "ltzzz-memory/魄.md",
      "ltzzz-memory/识神.md",
      "ltzzz-memory/梦境数据库.md",
      "ltzzz-memory/文明研究.md",
      "当日/昨日 Task-Result 摘要"
    ],
    "truthContract": [
      "proposed != applied",
      "planned != deployed",
      "API存在 != API已验证",
      "AI回复 != 实际结果"
    ],
    "outputSchema": "每条产出必须带 result / evidence / next 字段，缺失视为未过 Gate",
    "specialNote": "涉及修行/梦境内容时遵守 AI-ARCHIVE-INDEX 审核底线：体验≠科学事实，AI推测≠用户确认"
  },
  "ltzzz:identityStatus": {
    "signing_public_key_provisioned": false,
    "signature_verified": false,
    "chain_registration_verified": false,
    "note": "DID签名公钥与模型API Key是不同对象；未生成私钥、未授予链上签名权。"
  }
}
