# Skill core files, review records and the manifest are sha256-pinned to exact
# LF bytes. On Windows core.autocrlf=true would rewrite them to CRLF on checkout
# and make readSkill()/skillContext()/syncSkillAdapters() verification fail.
skills/** text eol=lf
.github/skills/** text eol=lf
.claude/skills/** text eol=lf
.agents/skills/** text eol=lf
knowledge/results/skill-review/** text eol=lf
config/ltzzz-skill.json text eol=lf
.gitattributes text eol=lf
