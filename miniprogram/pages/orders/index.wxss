/* 订单页专用样式：失败态、材料上传、材料清单 */

.error-card { border-left: 6rpx solid #c0392b; }
.error-card .body { color: #8c2f22; }

.retry-btn {
  margin-top: 24rpx;
  background: #ffffff;
  color: #18745e;
  border: 2rpx solid #18745e;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 2.4;
}
.retry-btn::after { border: none; }

.upload-btn {
  margin-top: 24rpx;
  background: #18745e;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 2.4;
}
.upload-btn::after { border: none; }

.intake-block { margin-top: 20rpx; }
.intake-item {
  color: #3d5a52;
  font-size: 26rpx;
  border-bottom: none;
  padding: 8rpx 0;
}

.upload-hint {
  margin-top: 24rpx;
  color: #18745e;
  font-size: 26rpx;
}
