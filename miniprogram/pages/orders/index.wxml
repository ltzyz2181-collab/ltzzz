<view class="page">
  <view class="heading">我的订单</view>
  <view class="intro" wx:if="{{payEnabled}}">支付成功后 24 小时内人工交付电子文档。材料请在订单卡片里直接上传，不必发进客服聊天。</view>
  <view class="intro" wx:else>当前开放服务介绍，在线预约尚未开放。</view>

  <view wx:if="{{loading}}" class="card"><view class="body">加载中…</view></view>

  <!-- 失败与空列表必须分开渲染：失败时不能显示「暂无订单记录」 -->
  <view wx:elif="{{error}}" class="card error-card">
    <view class="body">{{errorMessage}}</view>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{empty}}" class="card">
    <view class="body" wx:if="{{payEnabled}}">暂无订单记录。支付成功后订单会出现在这里。</view>
    <view class="body" wx:else>暂无订单记录。在线支付通道尚在开通中，当前只能浏览服务介绍。</view>
  </view>

  <view class="card" wx:for="{{orders}}" wx:key="_id">
    <view class="title">{{item.title}}</view>
    <view class="row">订单号：{{item.out_trade_no}}</view>
    <view class="row">金额：¥{{item.amountLabel}}</view>
    <view class="row">状态：{{item.statusLabel}}</view>
    <view class="row" wx:if="{{item.refundedLabel}}">已退金额：¥{{item.refundedLabel}}</view>
    <view class="row" wx:if="{{item.remainingLabel}}">剩余未退：¥{{item.remainingLabel}}（交付暂停）</view>
    <view class="row" wx:if="{{item.refundTimeLabel}}">退款完成时间：{{item.refundTimeLabel}}</view>
    <view class="refund-note" wx:if="{{item.refundNote}}">{{item.refundNote}}</view>
    <view class="row">下单时间：{{item.created_at_label}}</view>
    <view class="row" wx:if="{{item.delivered_at_label}}">交付时间：{{item.delivered_at_label}}</view>

    <view class="intake-block" wx:if="{{item.intakeFiles.length}}">
      <view class="row">已提交材料：</view>
      <view class="row intake-item" wx:for="{{item.intakeFiles}}" wx:for-item="file" wx:key="time">{{file.name}}（{{file.time}}）</view>
    </view>

    <button class="upload-btn" wx:if="{{item.canUpload}}" data-trade="{{item.out_trade_no}}" bindtap="chooseAndUpload">
      {{uploadingTradeNo === item.out_trade_no ? '上传中…' : '上传材料'}}
    </button>
  </view>

  <view class="upload-hint" wx:if="{{uploadingHint}}">{{uploadingHint}}</view>

  <button wx:if="{{payEnabled}}" class="contact-btn" open-type="contact" session-from="order-delivery">联系人工客服（兜底）</button>

  <view class="note">材料仅用于本单交付与售后核对，不会用于其他用途。单个文件不超过 10MB，每单最多 10 个。</view>
</view>
