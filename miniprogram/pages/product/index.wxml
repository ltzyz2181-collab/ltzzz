<view class="page" wx:if="{{product}}">
  <view class="tag">{{product.tag}}</view>
  <view class="heading">{{product.title}}</view>
  <view class="intro">{{product.summary}}</view>
  <view class="price">{{product.priceLabel}}</view>
  <view class="card">
    <view class="title">服务内容</view>
    <view class="row" wx:for="{{product.items}}" wx:key="*this">{{index + 1}}. {{item}}</view>
  </view>
  <view class="card">
    <view class="title">交付时效</view>
    <view class="body">{{product.delivery}}</view>
  </view>
  <view class="card warning">
    <view class="title">下单前须知</view>
    <view class="body">{{product.notice}}</view>
  </view>
  <view class="note">本页不提供在线支付或自动交付；下单与交付以实际服务页面为准。</view>
</view>
<view class="page" wx:else><view class="heading">未找到服务</view><view class="intro">请返回服务列表重新选择。</view></view>
