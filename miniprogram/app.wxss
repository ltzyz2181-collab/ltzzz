page { background: #f4f6f8; color: #122534; font-family: sans-serif; }
.page { padding: 36rpx; }
.eyebrow { color: #587080; font-size: 24rpx; letter-spacing: 3rpx; }
.heading { font-size: 44rpx; font-weight: 700; margin: 16rpx 0; line-height: 1.4; }
.intro { color: #536471; font-size: 28rpx; line-height: 1.8; }
.card { background: white; border-radius: 24rpx; padding: 32rpx; margin-top: 28rpx; }
.tag { color: #18745e; font-size: 24rpx; margin-bottom: 14rpx; }
.title { font-size: 34rpx; font-weight: 600; line-height: 1.5; }
.body { margin-top: 16rpx; font-size: 28rpx; color: #536471; line-height: 1.8; }
.price { margin-top: 22rpx; font-size: 32rpx; font-weight: 600; }
.link { color: #18745e; margin-top: 22rpx; font-size: 28rpx; }
.note { color: #687884; font-size: 24rpx; margin-top: 28rpx; line-height: 1.8; }
.row { padding: 18rpx 0; border-bottom: 1rpx solid #e9eef1; font-size: 28rpx; line-height: 1.7; }
.warning { border-left: 6rpx solid #18745e; padding-left: 22rpx; }
.refund-note { margin-top: 20rpx; padding: 18rpx 20rpx; background: #f2f7f5; border-left: 6rpx solid #18745e; color: #3d5a52; font-size: 26rpx; line-height: 1.8; border-radius: 0 12rpx 12rpx 0; }
.buy-bar { margin-top: 32rpx; }
.agree-row { display: flex; align-items: flex-start; padding: 12rpx 0; }
.checkbox { width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; border: 2rpx solid #9fb0ba; border-radius: 8rpx; margin-right: 14rpx; margin-top: 4rpx; font-size: 24rpx; color: #ffffff; flex-shrink: 0; }
.checkbox.checked { background: #18745e; border-color: #18745e; }
.agree-text { flex: 1; font-size: 24rpx; color: #536471; line-height: 1.7; }
.agree-link { color: #18745e; }
.buy-btn { margin-top: 18rpx; background: #18745e; color: #ffffff; border-radius: 14rpx; font-size: 32rpx; line-height: 2.4; }
.buy-btn::after { border: none; }
.buy-btn[disabled] { background: #9fb0ba; color: #ffffff; }
.order-link { text-align: center; color: #587080; font-size: 24rpx; margin-top: 22rpx; }
.contact-btn { margin-top: 32rpx; background: #ffffff; color: #18745e; border: 2rpx solid #18745e; border-radius: 14rpx; font-size: 28rpx; line-height: 2.4; }
.contact-btn::after { border: none; }
