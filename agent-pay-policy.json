{
  "version": "0.2",
  "governance": {
    "controller": "ChatGPT",
    "experts": ["Doubao", "DeepSeek", "Grok", "Claude"],
    "architecture_change": {
      "required_yes_votes": 3,
      "total_agents": 5,
      "user_confirmation_required": true
    }
  },
  "payment": {
    "default_currency": "USD",
    "rails": ["x402", "MPP", "visa-agentic", "mastercard-agent-pay"],
    "modes": ["human-confirm", "policy-auto", "agent-vote"],
    "default_mode": "human-confirm",
    "default_budget_usd": 1.0,
    "default_single_cap_usd": 0.02,
    "real_funds_enabled": false,
    "stablecoin": {
      "planned": "USDC",
      "status": "not-live"
    }
  },
  "treasury": {
    "base": "Safe Smart Account",
    "agent_signer": "restricted-module-or-allowance-only",
    "production_auto_withdraw": false,
    "required_controls": [
      "memory-gate",
      "payment-proposal",
      "budget-check",
      "single-tx-cap",
      "daily-limit",
      "monthly-limit",
      "chain-allowlist",
      "token-allowlist",
      "destination-allowlist",
      "human-confirm-threshold",
      "receipt-verification",
      "ledger-write"
    ]
  },
  "providers": {
    "DeepSeek": {"billing": "provider-account", "agent_payment": "adapter-planned"},
    "Doubao": {"billing": "provider-account", "agent_payment": "adapter-planned"},
    "Claude": {"billing": "provider-account", "agent_payment": "adapter-planned"},
    "Grok": {"billing": "provider-account", "agent_payment": "adapter-planned"}
  },
  "rule": "LTZZZ Agentic Payment is a separate payment-control layer; it does not replace a model provider's own billing system. No AI may independently modify treasury policy or move LTZZZ production funds."
}
