# Copy to .env on the SERVER only. Never commit .env
PORT=8787
# Comma-separated origins, e.g. https://ltzzz.com,https://ltzyz2181-collab.github.io
CORS_ORIGIN=https://ltzzz.com,https://ltzyz2181-collab.github.io
# Optional simple gate token; front-end sends header X-Lab-Token
LAB_TOKEN=

# Fill only the providers you use:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Volcengine / Doubao — adjust base URL per official docs
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=
# xAI Grok if you have API access
XAI_API_KEY=
XAI_MODEL=grok-3
